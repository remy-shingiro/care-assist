rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isManager() {
      return signedIn() &&
        request.auth.token.role == 'manager';
    }

    function isBookingOwner(patientId) {
      return isOwner(patientId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();

      allow create: if isOwner(userId) &&
        request.resource.data.role == 'patient';

      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role;
    }

    match /assistants/{assistantId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    match /bookings/{bookingId} {
      allow read: if isManager() ||
        isBookingOwner(resource.data.patientId);

      allow create: if signedIn() &&
        !isManager() &&
        request.resource.data.keys().hasOnly([
          'patientId',
          'preferredAssistantId',
          'assignedAssistantId',
          'hospitalName',
          'wardOrRoom',
          'date',
          'startTime',
          'endTime',
          'serviceDescription',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.patientId == request.auth.uid &&
        request.resource.data.preferredAssistantId is string &&
        request.resource.data.assignedAssistantId == null &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.hospitalName is string &&
        (
          request.resource.data.wardOrRoom is string ||
          request.resource.data.wardOrRoom == null
        ) &&
        request.resource.data.date is string &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.serviceDescription is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/activeBookings/$(request.auth.uid)).data.bookingId == bookingId;

      allow update: if request.resource.data.updatedAt == request.time &&
        (
          (isManager() &&
            resource.data.status == 'PENDING' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'assignedAssistantId', 'status', 'updatedAt'
            ]) &&
            request.resource.data.status in ['CONFIRMED', 'REJECTED'] &&
            (
              (request.resource.data.status == 'REJECTED' &&
                request.resource.data.assignedAssistantId == null &&
                !existsAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId))) ||
              (request.resource.data.status == 'CONFIRMED' &&
                request.resource.data.assignedAssistantId is string &&
                get(/databases/$(database)/documents/assistants/$(request.resource.data.assignedAssistantId)).data.active == true &&
                getAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId)).data.bookingId == bookingId)
            )) ||
          (isManager() &&
            resource.data.status == 'CONFIRMED' &&
            request.resource.data.status == 'CONFIRMED' &&
            request.resource.data.assignedAssistantId is string &&
            request.resource.data.assignedAssistantId != resource.data.assignedAssistantId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'assignedAssistantId', 'updatedAt'
            ]) &&
            get(/databases/$(database)/documents/assistants/$(request.resource.data.assignedAssistantId)).data.active == true &&
            getAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId)).data.bookingId == bookingId) ||
          (isManager() &&
            resource.data.status == 'CONFIRMED' &&
            request.resource.data.status == 'CANCELLED' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            !existsAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId))) ||
          (isBookingOwner(resource.data.patientId) &&
            request.resource.data.patientId == resource.data.patientId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            ((resource.data.status in ['PENDING', 'CONFIRMED'] &&
                request.resource.data.status == 'CANCELLED' &&
                !existsAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId))) ||
              (resource.data.status == 'CONFIRMED' &&
                request.resource.data.status == 'IN_PROGRESS' &&
                getAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId)).data.bookingId == bookingId) ||
              (resource.data.status == 'IN_PROGRESS' &&
                request.resource.data.status == 'COMPLETED' &&
                !existsAfter(/databases/$(database)/documents/activeBookings/$(resource.data.patientId)))))
        );
      allow delete: if false;
    }

    match /activeBookings/{patientId} {
      allow read: if isOwner(patientId) || isManager();
      allow create: if isOwner(patientId) &&
        request.resource.data.keys().hasOnly(['bookingId', 'patientId']) &&
        request.resource.data.patientId == patientId &&
        request.resource.data.bookingId is string &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.patientId == patientId &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.status == 'PENDING';
      allow delete: if (isManager() || isOwner(patientId)) &&
        getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.patientId == patientId &&
        getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status in [
          'REJECTED', 'CANCELLED', 'COMPLETED'
        ];
      allow update: if false;
    }

    match /educationContent/{contentId} {
      allow read: if isManager() ||
        (signedIn() && request.auth.token.role == 'patient' && resource.data.published == true);
      allow create: if isManager() &&
        request.resource.data.keys().hasOnly([
          'title', 'summary', 'body', 'type', 'imageUrl', 'videoUrl',
          'published', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.summary is string &&
        request.resource.data.body is string &&
        request.resource.data.type in ['article', 'video'] &&
        (request.resource.data.imageUrl is string || request.resource.data.imageUrl == null) &&
        (request.resource.data.videoUrl is string || request.resource.data.videoUrl == null) &&
        request.resource.data.published is bool &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isManager() &&
        request.resource.data.keys().hasOnly([
          'title', 'summary', 'body', 'type', 'imageUrl', 'videoUrl',
          'published', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.title is string &&
        request.resource.data.summary is string &&
        request.resource.data.body is string &&
        request.resource.data.type in ['article', 'video'] &&
        (request.resource.data.imageUrl is string || request.resource.data.imageUrl == null) &&
        (request.resource.data.videoUrl is string || request.resource.data.videoUrl == null) &&
        request.resource.data.published is bool;
      allow delete: if isManager();
    }
  }
}