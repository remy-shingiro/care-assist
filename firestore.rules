rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isManager() {
      return signedIn() &&
        request.auth.token.role == 'manager';
    }

    function isBookingOwner(patientId) {
      return isOwner(patientId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.role == 'patient';

      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role;
    }

    match /assistants/{assistantId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    match /bookings/{bookingId} {
      allow read: if isManager() ||
        isBookingOwner(resource.data.patientId);

      allow create: if signedIn() &&
        !isManager() &&
        request.resource.data.keys().hasOnly([
          'patientId',
          'preferredAssistantId',
          'assignedAssistantId',
          'hospitalName',
          'wardOrRoom',
          'date',
          'startTime',
          'endTime',
          'serviceDescription',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.patientId == request.auth.uid &&
        request.resource.data.preferredAssistantId is string &&
        request.resource.data.assignedAssistantId == null &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.hospitalName is string &&
        (
          request.resource.data.wardOrRoom is string ||
          request.resource.data.wardOrRoom == null
        ) &&
        request.resource.data.date is string &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.serviceDescription is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update, delete: if false;
    }

    match /educationContent/{contentId} {
      allow read: if signedIn();
      allow write: if isManager();
    }
  }
}